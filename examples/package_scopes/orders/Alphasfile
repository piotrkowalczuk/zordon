package "orders" {
  import "github.com/zordon-io/zordon-modules/caddy" {
    inputs = {
      sites = {
        orders = {
          host = "orders.test"
          reverse_proxy = {
            to = ["127.0.0.1:${component.orders.service.go.orders.vars.port}"]
          }
        }
      }
    }
  }

  import "../store" {
    inputs = {
      label = "orders-default"
      seed  = { orders_schema = "v1" }
    }
  }

  component "orders" {
    service "go" "orders" {
      src {
        path = "../../.."
        exe  = "./examples/package_scopes/src/worker"
      }

      vars = { port = net::pickport() }

      runtime {
        cmd   = ["${fs::bin()}/${self.name}", "-addr", "127.0.0.1:${self.vars.port}", "-name", "orders", "-prefix", "/orders/", "-store", package.store.outputs.url]
        after = [package.store.outputs.ready]
      }

      readiness {
        http {
          path = "/orders/"
          port = self.vars.port
        }
        period            = "200ms"
        failure_threshold = 50
      }
    }
  }
}
