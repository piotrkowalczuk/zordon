package "billing" {
  import "github.com/zordon-io/zordon-modules/caddy" {
    inputs = {
      sites = {
        billing = {
          host = "billing.test"
          reverse_proxy = {
            to = ["127.0.0.1:${component.billing.service.go.billing.vars.port}"]
          }
        }
      }
    }
  }

  import "../store" {
    inputs = {
      label = "billing-default"
      seed  = { billing_schema = "v1" }
    }
  }

  component "billing" {
    service "go" "billing" {
      src {
        path = "../../.."
        exe  = "./examples/package_scopes/src/worker"
      }

      vars = { port = net::pickport() }

      runtime {
        cmd   = ["${fs::bin()}/${self.name}", "-addr", "127.0.0.1:${self.vars.port}", "-name", "billing", "-prefix", "/billing/", "-store", package.store.outputs.url]
        after = [package.store.outputs.ready]
      }

      readiness {
        http {
          path = "/billing/"
          port = self.vars.port
        }
        period            = "200ms"
        failure_threshold = 50
      }
    }
  }
}
