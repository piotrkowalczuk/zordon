package "store" {
  features = {
    audit = { description = "Enables audit mode on the store." }
  }
  inputs = {
    label = {
      description = "Store instance label."
      type        = string
      default     = "default"
    }
    seed = {
      description = "Initial key-value entries merged from all importers."
      type        = map(string)
      default     = {}
    }
  }
  outputs = {
    url = {
      description = "Where the store listens."
      type        = string
      value       = "http://127.0.0.1:${component.store.service.go.store.vars.port}"
    }
    ready = {
      description = "The store answers requests."
      type        = string
      value       = component.store.service.go.store.runtime.ready
    }
  }

  component "store" {
    service "go" "store" {
      src {
        path = "../../.."
        exe  = "./examples/package_scopes/src/store"
      }

      vars = {
        port = net::pickport()
      }

      file "seed" {
        path = "${fs::etc()}/seed.json"
        body = enc::json(inputs.seed)
      }

      runtime {
        cmd = ["${fs::bin()}/${self.name}", "-addr", "127.0.0.1:${self.vars.port}", "-label", inputs.label, "-seed", self.file.seed.path, "-audit=${features.audit}"]
      }

      readiness {
        http {
          path = "/info"
          port = self.vars.port
        }
        period            = "200ms"
        failure_threshold = 50
      }
    }
  }
}
