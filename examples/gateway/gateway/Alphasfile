# An API gateway. It knows no service: each one adds an entry to the routes
# map, and two services claiming the same key or prefix are an error. Its
# inputs and outputs are its API: what it takes, where it listens and when it
# is ready.
package "gateway" {
  features = {
    access_log = { description = "Prints every request the gateway proxies." }
  }
  inputs = {
    port = {
      description = "Port to listen on; null picks a free one."
      type        = number
      default     = null
    }
    routes = {
      description = "Path prefixes to proxy, by service, such as { orders = { prefix = \"/orders/\", upstream = \"127.0.0.1:8081\" } }."
      type        = map(object({ prefix = string, upstream = string }))
      default     = {}
      unique      = ["prefix"]
    }
  }
  outputs = {
    url = {
      description = "Where the gateway listens."
      type        = string
      value       = "http://127.0.0.1:${module.gateway.service.go.gateway.vars.port}"
    }
    ready = {
      description = "The gateway answers requests."
      type        = string
      value       = module.gateway.service.go.gateway.runtime.ready
    }
  }

  module "gateway" {
    service "go" "gateway" {
      src {
        path = "../../.."
        exe  = "./examples/gateway/src/gateway"
      }

      vars = {
        port = inputs.port != null ? inputs.port : net::pickport()
      }

      file "routes" {
        path = "${fs::etc()}/routes.json"
        body = enc::json(inputs.routes)
      }

      runtime {
        cmd = ["${fs::bin()}/${self.name}", "-addr", "127.0.0.1:${self.vars.port}", "-routes", self.file.routes.path, "-access-log=${features.access_log}"]
      }

      readiness {
        http {
          path = "/healthz"
          port = self.vars.port
        }
        period            = "200ms"
        failure_threshold = 50
      }
    }
  }
}
