sysenv = ["HOME", "USER", "PATH", "LANG", "LC_ALL", "TZ", "TERM", "TMPDIR"]

service "go" "caddy" {
  git   = "github.com/caddyserver/caddy"
  tag   = "v2.10.0"
  exe   = "./cmd/caddy"

  vars = {
    http       = net::pickport()
    config_dir = "${fs::tmp()}/conf.d"
  }

  file "caddyfile" {
    path = "${fs::tmp()}/Caddyfile"
    body = <<-EOT
      {
      	admin off
      	auto_https off
      }

      :${self.vars.http} {
      	respond /healthz "ok" 200
      }

      import ${self.vars.config_dir}/*.caddy
    EOT
  }

  file "seed" {
    path = "${self.vars.config_dir}/00-root.caddy"
    body = "# zordon federation root — children drop their vhosts here\n"
  }

  runtime {
    cmd = ["${fs::bin()}/caddy", "run", "--config", self.file.caddyfile.path, "--adapter", "caddyfile", "--watch"]
  }

  readiness {
    http {
      path = "/healthz"
      port = self.vars.http
    }
    period            = "200ms"
    timeout           = "1s"
    failure_threshold = 50
  }

  sudo "http80" {
    check  = "test -f '${fs::tmp()}/pf80.${self.vars.http}' && grep -q 'rdr-anchor \"zordon\"' /etc/pf.conf"
    apply  = <<-EOT
      set -e
      cp -n /etc/pf.conf /etc/pf.conf.zordon.bak 2>/dev/null || true
      if ! grep -q 'rdr-anchor "zordon"' /etc/pf.conf; then
        awk '{print} /^rdr-anchor "com\.apple\/\*"/{print "rdr-anchor \"zordon\""}' /etc/pf.conf > /etc/pf.conf.zordon.new
        grep -q 'rdr-anchor "zordon"' /etc/pf.conf.zordon.new || { echo 'could not locate apple rdr-anchor in /etc/pf.conf; aborting' >&2; rm -f /etc/pf.conf.zordon.new; exit 1; }
        cat /etc/pf.conf.zordon.new > /etc/pf.conf
        rm -f /etc/pf.conf.zordon.new
      fi
      pfctl -f /etc/pf.conf
      echo 'rdr pass on lo0 inet proto tcp from any to 127.0.0.1 port 80 -> 127.0.0.1 port ${self.vars.http}' | pfctl -a zordon -f -
      pfctl -e 2>/dev/null || true
      mkdir -p '${fs::tmp()}'
      : > '${fs::tmp()}/pf80.${self.vars.http}'
    EOT
    verify = "nc -z -G 2 127.0.0.1 80"
  }
}

service "go" "coredns" {
  git = "github.com/coredns/coredns"
  tag = "v1.14.3"

  vars = {
    dns = net::pickport()
  }

  file "corefile" {
    path = "${fs::tmp()}/Corefile"
    body = <<-EOT
      test:${self.vars.dns} {
        template IN A {
          answer "{{ .Name }} 60 IN A 127.0.0.1"
        }
        log
      }
    EOT
  }

  runtime {
    cmd = ["${fs::bin()}/coredns", "-conf", self.file.corefile.path]
  }

  sudo "resolver" {
    check  = "grep -qxF 'port ${self.vars.dns}' /etc/resolver/test 2>/dev/null"
    apply  = <<-EOT
      mkdir -p /etc/resolver && printf 'nameserver 127.0.0.1\nport ${self.vars.dns}\n' > /etc/resolver/test
    EOT
    verify = "grep -qxF 'port ${self.vars.dns}' /etc/resolver/test"
  }
}
