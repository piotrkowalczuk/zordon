sysenv = ["HOME", "USER", "PATH", "LANG", "LC_ALL", "TZ", "TERM", "TMPDIR"]

service "go" "app" {
  src {
    path = "../.."
    exe  = "./examples/antigravity_plugin/src/app"
  }

  vars  = { port = net::pickport() }
  print = "http://127.0.0.1:${self.vars.port}/  (agy example)"

  runtime {
    cmd = ["${fs::bin()}/app", "-addr", "127.0.0.1:${self.vars.port}"]
  }

  readiness {
    http {
      path = "/"
      port = self.vars.port
    }
    period            = "200ms"
    failure_threshold = 50
  }
}
