# Closed-world env: services see ONLY these host vars from the shell
# zordon was invoked from. Anything else (RUBYLIB, GEM_HOME, BUNDLE_*,
# user-shell mise activation) is stripped — and the same closed world is
# what `gem install bundler` runs under, so a service "pinned" to the
# ruby below actually uses THAT ruby and THAT bundler, not whatever the
# user shell happens to expose.
sysenv = ["HOME", "USER", "PATH", "LANG", "LC_ALL", "TZ", "TERM", "TMPDIR"]

toolchain {
  # Ruby toolchains in mise live as fully separate worlds: every pinned
  # version has its own gem set (and its own bundler!), so packages
  # declared here get installed via `gem install` inside THIS Ruby
  # install — never leaking into another version's world. zordon pins
  # GEM_HOME/GEM_PATH to that world and moves bundler's global config and
  # cache out of ~/.bundle, so ~/.gem, ~/.gemrc and ~/.bundle on the host
  # are never consulted.
  ruby {
    version = "3.3.6"
    tools = {
      # bundler is the classic "version-per-Ruby" tool — a Gemfile.lock
      # pinned to 2.5.6 won't load on a stock Ruby 3.3 because the
      # bundled one is newer. Declaring it here installs that version
      # into the pinned ruby AND sets BUNDLER_VERSION, so the `bundle`
      # shim runs exactly it instead of auto-installing whatever the
      # lockfile says over the network.
      bundler = "2.5.6"
    }
  }
}

service "ruby" "app" {
  src {
    path = "../.."
    exe  = "examples/ruby/src/app"
  }

  # No build block: the default is `bundle install`, run with BUNDLE_PATH
  # pointing at <state>/bundle/app — gems land outside the checkout and
  # nothing is written into the source tree. The Gemfile here is empty
  # (the app is stdlib-only), so the install fetches nothing; the
  # lockfile's BUNDLED WITH matches the declared bundler.

  vars = { port = net::pickport() }

  runtime {
    cmd = ["bundle", "exec", "ruby", "app.rb", "-addr", "127.0.0.1:${self.vars.port}"]
  }

  readiness {
    http {
      path = "/"
      port = self.vars.port
    }
    period            = "200ms"
    failure_threshold = 50
  }
}
