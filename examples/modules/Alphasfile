sysenv = ["HOME", "USER", "PATH", "LANG", "LC_ALL", "TZ", "TERM", "TMPDIR"]

# One stack, two teams. Each module owns a `db` and an `api`; the names
# collide on purpose — the module is what keeps them apart. Inside a module
# `service.go.db` means that module's db; from outside it is
# `module.payments.service.go.db`. Display names are `payments/db`,
# `auth/api`, … (picks, `zordon status`, checkout dirs), and a module
# service builds into its module bin dir: `${fs::bin()}` there is `<bin>/<module>`.

service "go" "gateway" {
  src {
    path = "../.."
    exe  = "./examples/modules/src/gateway"
  }

  vars = { port = net::pickport() }

  runtime {
    cmd = [
      "${fs::bin()}/gateway",
      "-addr", "127.0.0.1:${self.vars.port}",
      "-name", self.name,
      "-upstream", "payments=127.0.0.1:${module.payments.service.go.api.vars.port},auth=127.0.0.1:${module.auth.service.go.api.vars.port}",
    ]
    after = [
      module.payments.service.go.api.runtime.ready,
      module.auth.service.go.api.runtime.ready,
    ]
  }

  print = "http://127.0.0.1:${self.vars.port}/  (gateway → payments/api, auth/api)"

  readiness {
    http {
      path = "/"
      port = self.vars.port
    }
    period            = "200ms"
    failure_threshold = 50
  }
}

module "payments" {
  service "go" "db" {
    src {
      path = "../.."
      exe  = "./examples/modules/src/payments_db"
    }

    vars = { port = net::pickport() }

    runtime {
      cmd = ["${fs::bin()}/${self.name}", "-addr", "127.0.0.1:${self.vars.port}", "-name", "${self.module}/${self.name}"]
    }

    readiness {
      http {
        path = "/"
        port = self.vars.port
      }
      period            = "200ms"
      failure_threshold = 50
    }
  }

  service "go" "api" {
    src {
      path = "../.."
      exe  = "./examples/modules/src/payments_api"
    }

    vars = { port = net::pickport() }

    runtime {
      cmd = [
        "${fs::bin()}/${self.name}",
        "-addr", "127.0.0.1:${self.vars.port}",
        "-name", "${self.module}/${self.name}",
        "-upstream", "db=127.0.0.1:${service.go.db.vars.port}",
      ]
      after = [service.go.db.runtime.ready]
    }

    readiness {
      http {
        path = "/"
        port = self.vars.port
      }
      period            = "200ms"
      failure_threshold = 50
    }
  }
}

