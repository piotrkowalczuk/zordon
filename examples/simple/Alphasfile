service "go" "nats-server" {
  git = "github.com/nats-io/nats-server"
  tag = "v2.14.0"

  vars = {
    client = net::pickport()
    http   = net::pickport()
  }

  arguments = {
    D = false
    V = false
    p = self.vars.client
    m = self.vars.http
  }
}

service "rust" "tansu" {
  cargo      = "tansu"
  features   = ["dynostore"]
  doubleDash = true

  vars = {
    kafka = net::pickport()
  }

  arguments = {
    listener-url            = "tcp://127.0.0.1:${self.vars.kafka}"
    advertised-listener-url = "tcp://127.0.0.1:${self.vars.kafka}"
  }
}

service "go" "prometheus" {
  git   = "github.com/prometheus/prometheus"
  tag   = "v3.11.3"
  exe   = "./cmd/prometheus"
  doubleDash = true

  vars = {
    port = net::pickport()
  }

  arguments = {
    "config.file"        = self.file.config.path
    "log.format"         = "json"
    "web.listen-address" = ":${self.vars.port}"
    "storage.tsdb.path"  = "${fs::tmp()}/prometheus-data"
  }

  file "config" {
    path = "${fs::tmp()}/prometheus.yml"
    body = <<-EOT
      global:
        scrape_interval: 15s

      scrape_configs: []
    EOT
  }

  readiness {
    http {
      path = "/-/ready"
      port = self.vars.port
    }
    period            = "200ms"
    timeout           = "1s"
    failure_threshold = 30
  }
}

service "ruby" "ruby-service" {
  git = "github.com/niwasawa/ruby-sinatra-hello-world"

  build {
    cmd = ["bundle", "install", "--path", "vendor/bundle"]
  }

  vars = {
    port = net::pickport()
  }

  env = {
    PORT = self.vars.port
  }

  log {
    format = "plain"
    filter = "^\\tfrom |^/Users/.*|:in `.*'|:in `<.*>'"
  }

  runtime {
    cmd = ["bundle", "exec", "rackup", "-p", "${self.vars.port}", "-o", "0.0.0.0", "config.ru"]
  }

  readiness {
    http {
      port = self.vars.port
      path = "/"
    }
  }
}
