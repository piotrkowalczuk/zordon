service "go" "nats-server" {
  import = "github.com/nats-io/nats-server/v2"
  branch = "v2.14.0"

  vars = {
    client = net::pickport()
    http   = net::pickport()
  }

  arguments = {
    D = false
    V = false
    p = self.vars.client
    m = self.vars.http
  }
}

service "rust" "tansu" {
  crate        = "tansu"
  all_features = true
}

service "go" "prometheus" {
  import     = "github.com/prometheus/prometheus/cmd/prometheus"
  branch     = "v3.11.3"
  doubleDash = true

  vars = {
    port = net::pickport()
  }

  arguments = {
    "config.file"        = self.file.config.path
    "log.format"         = "json"
    "web.listen-address" = ":${self.vars.port}"
  }

  file "config" {
    path = "${tmpdir()}/prometheus.yml"
    body = <<-EOT
      global:
        scrape_interval: 15s

      scrape_configs: []
    EOT
  }

  readiness {
    http {
      path = "/-/ready"
      port = self.vars.port
    }
    period            = "200ms"
    timeout           = "1s"
    failure_threshold = 30
  }
}

service "ruby" "ruby-service" {
  git     = "github.com/niwasawa/ruby-sinatra-hello-world"
  install = "bundle install --path vendor/bundle"
  run     = "bundle exec ruby myapp.rb"

  log {
    format = "plain"
    filter = "^\\tfrom |^/Users/.*|:in `.*'|:in `<.*>'"
  }

  vars = {
    port = net::pickport()
  }

  arguments = {
    p = self.vars.port
  }
}
