# Every service has a primary repo (`git` = zordon-owned bare clone, or
# `dir` = your own checkout) and is materialized into a per-invocation git
# worktree, built there, and run from there. `build` overrides the
# per-toolchain default (go: `go build -o ./<name> .`, rust:
# `cargo build --release`, ruby: `bundle install`).
#
# A service with neither git nor dir (here: the tansu crate) isn't
# worktree-able — it's expected on $PATH (e.g. `cargo install tansu`).

service "go" "nats-server" {
  git = "github.com/nats-io/nats-server"
  tag = "v2.14.0"
  # default build: go build -o ./nats-server .

  vars = {
    client = net::pickport()
    http   = net::pickport()
  }

  arguments = {
    D = false
    V = false
    p = self.vars.client
    m = self.vars.http
  }
}

service "rust" "tansu" {
  crate = "tansu" # not worktree-able; expected on $PATH
}

service "go" "prometheus" {
  git        = "github.com/prometheus/prometheus"
  tag        = "v3.11.3"
  build      = "go build -o ./prometheus ./cmd/prometheus"
  doubleDash = true

  vars = {
    port = net::pickport()
  }

  arguments = {
    "config.file"        = self.file.config.path
    "log.format"         = "json"
    "web.listen-address" = ":${self.vars.port}"
  }

  file "config" {
    path = "${tmpdir()}/prometheus.yml"
    body = <<-EOT
      global:
        scrape_interval: 15s

      scrape_configs: []
    EOT
  }

  readiness {
    http {
      path = "/-/ready"
      port = self.vars.port
    }
    period            = "200ms"
    timeout           = "1s"
    failure_threshold = 30
  }
}

service "ruby" "ruby-service" {
  git   = "github.com/niwasawa/ruby-sinatra-hello-world"
  build = "bundle install --path vendor/bundle"

  log {
    format = "plain"
    filter = "^\\tfrom |^/Users/.*|:in `.*'|:in `<.*>'"
  }

  vars = {
    port = net::pickport()
  }

  command = ["bundle", "exec", "ruby", "myapp.rb", "-p", "${self.vars.port}"]
}
