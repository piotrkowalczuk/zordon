sysenv = ["HOME", "USER", "PATH", "LANG", "LC_ALL", "TZ", "TERM", "TMPDIR"]

service "go" "serviceA" {
  src {
    path = "../.."
    exe = "./examples/workspace/src/serviceA"
  }

  vars = {
    port = net::pickport()
  }

  runtime {
    cmd = [
      "${fs::bin()}/serviceA",
      "-addr", "127.0.0.1:${self.vars.port}",
      "-tag", "${fs::hash()}",
    ]
  }

  print = "http://127.0.0.1:${self.vars.port}/  (serviceA, workspace ${fs::hash()})"

  workspace {
    sparse = ["examples/workspace/src/serviceA"]
  }

  readiness {
    http {
      path = "/"
      port = self.vars.port
    }
    period            = "200ms"
    failure_threshold = 50
  }
}

