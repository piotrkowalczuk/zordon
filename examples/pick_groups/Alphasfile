# Picks: a service by its own name when it is unique, a component, a package,
# or a component of a package. shop and billing each have a service named
# worker, so "worker" alone names two services and is refused.
sysenv = ["HOME", "USER", "PATH", "LANG", "LC_ALL", "TZ", "TERM", "TMPDIR"]

import "./shop" {}
import "./billing" {}

service "go" "web" {
  src {
    path = "../.."
    exe  = "./examples/pick_groups/src/app"
  }

  vars = { port = net::pickport() }

  runtime {
    cmd = ["${fs::bin()}/${self.name}", "-name", "web", "-addr", "127.0.0.1:${self.vars.port}"]
  }

  workspace {
    sparse = ["examples/pick_groups/src/app"]
  }

  readiness {
    http {
      path = "/"
      port = self.vars.port
    }
    period            = "200ms"
    failure_threshold = 50
  }
}

component "api" {
  service "go" "http" {
    src {
      path = "../.."
      exe  = "./examples/pick_groups/src/app"
    }

    vars = { port = net::pickport() }

    runtime {
      cmd = ["${fs::bin()}/${self.name}", "-name", "http", "-addr", "127.0.0.1:${self.vars.port}"]
    }

    workspace {
      sparse = ["examples/pick_groups/src/app"]
    }

    readiness {
      http {
        path = "/"
        port = self.vars.port
      }
      period            = "200ms"
      failure_threshold = 50
    }
  }

  service "go" "grpc" {
    src {
      path = "../.."
      exe  = "./examples/pick_groups/src/app"
    }

    vars = { port = net::pickport() }

    runtime {
      cmd = ["${fs::bin()}/${self.name}", "-name", "grpc", "-addr", "127.0.0.1:${self.vars.port}"]
    }

    workspace {
      sparse = ["examples/pick_groups/src/app"]
    }

    readiness {
      http {
        path = "/"
        port = self.vars.port
      }
      period            = "200ms"
      failure_threshold = 50
    }
  }
}
