# Two components in one fragment. Each depends on kafka, so each imports it:
# an import belongs to the component that needs it and joins the stack only
# with that component. Without it `component.kafka` is not visible in the component.
component "app" {
  import "../kafka/Alphasfile.kafka" {
    components = ["kafka"]
  }

  service "go" "app" {
    src {
      path = "../../../.."
      exe  = "./examples/import/src/app"
    }

    vars = { port = net::pickport() }

    runtime {
      cmd = ["${fs::bin()}/${self.name}", "-addr", "127.0.0.1:${self.vars.port}"]

      provision "topic" {
        after = [self.runtime.ready, component.kafka.service.go.kafka.runtime.ready]
        cmd   = component.kafka.service.go.kafka.runtime.provision.create-topic
        env   = { TOPIC = "app-events" }
      }
    }

    readiness {
      http {
        path = "/"
        port = self.vars.port
      }
      period            = "200ms"
      failure_threshold = 50
    }
  }
}

component "billing" {
  import "../kafka/Alphasfile.kafka" {
    components = ["kafka"]
  }

  service "go" "billing" {
    src {
      path = "../../../.."
      exe  = "./examples/import/src/billing"
    }

    vars = { port = net::pickport() }

    runtime {
      cmd = ["${fs::bin()}/${self.name}", "-addr", "127.0.0.1:${self.vars.port}"]

      provision "topic" {
        after = [self.runtime.ready, component.kafka.service.go.kafka.runtime.ready]
        cmd   = component.kafka.service.go.kafka.runtime.provision.create-topic
        env   = { TOPIC = "billing-events" }
      }
    }

    readiness {
      http {
        path = "/"
        port = self.vars.port
      }
      period            = "200ms"
      failure_threshold = 50
    }
  }
}
