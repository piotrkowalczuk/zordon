dotenv = "${fs::tmp()}/global.env"

service "go" "cache" {
  src = "../.."
  exe = "./examples/interpolation/src/app"

  vars = {
    port = net::pickport()
  }

  file "globalenv" {
    path = "${fs::tmp()}/global.env"
    body = <<-EOT
      SOURCE=global-dotenv
      GLOBAL_ONLY=g-${pathhash()}
      API_LABEL=from-global
    EOT
  }

  runtime {
    cmd = ["${fs::bin()}/cache", "-addr", "127.0.0.1:${self.vars.port}"]
  }

  readiness {
    http {
      path = "/"
      port = self.vars.port
    }
    period            = "200ms"
    failure_threshold = 50
  }
}

service "go" "api" {
  src = "../.."
  exe = "./examples/interpolation/src/app"

  arguments = {
    "config.file" = self.file.conf.path
  }

  vars = {
    port  = net::pickport()
    label = "api-${pathhash()}"
  }

  build {
    cmd = [
      "go", "build",
      "-ldflags", "-X main.Tag=${pathhash()}",
      "-o", "${fs::bin()}/app",
      "./examples/interpolation/src/app",
    ]
  }

  runtime {
    cmd = [
      "${fs::bin()}/app",
      "-addr", "127.0.0.1:${self.vars.port}",
      "-cache", "127.0.0.1:${service.go.cache.vars.port}",
      "-conf", "${self.file.conf.path}",
    ]
  }

  file "appenv" {
    path = "${fs::tmp()}/api.env"
    body = <<-EOT
      SOURCE=service-dotenv
      API_LABEL=from-service
    EOT
  }
  dotenv = "${self.file.appenv.path}"

  env = {
    SOURCE     = "env-block"
    API_LABEL  = "${self.vars.label}"
    CACHE_ADDR = "127.0.0.1:${service.go.cache.vars.port}"
  }

  file "conf" {
    path = "${fs::tmp()}/api.conf"
    body = <<-EOT
      label       = ${self.vars.label}
      listen      = 127.0.0.1:${self.vars.port}
      cache_addr  = 127.0.0.1:${service.go.cache.vars.port}
      cache_src   = ${service.go.cache.dir}
      my_src      = ${fs::src()}
      invocation  = ${pathhash()}
    EOT
  }

  readiness {
    http {
      path = "/"
      port = self.vars.port
    }
    period            = "200ms"
    failure_threshold = 50
  }
}
