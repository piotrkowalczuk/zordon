# frozen_string_literal: true

# A deliberately small Rails app: railties + actionpack + activerecord
# instead of the `rails` meta-gem, so the bundle skips ActionCable,
# ActiveStorage, ActionMailer and friends the example never touches.
source "https://rubygems.org"

gem "actionpack", "~> 8.1.0"
gem "activerecord", "~> 8.1.0"
gem "puma", "~> 7.0"
gem "railties", "~> 8.1.0"
gem "sqlite3", "~> 2.1"
