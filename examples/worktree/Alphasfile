# examples/worktree — parallel, isolated worktrees over THIS file.
#
# `src = "../.."` points the primary at the zordon repo this Alphasfile
# lives in.
#
# `exe = "./src/example"` names the main package path;
# the Go toolchain builds it into fs::bin().

service "go" "example" {
  src = "../.."
  exe = "./examples/worktree/src/example"

  vars = {
    port = net::pickport()
  }

  cmd = [
    "${fs::bin()}/example",
    "-addr", "127.0.0.1:${self.vars.port}",
    "-tag", "${pathhash()}",
  ]

  worktree = {
    sparse = ["examples/worktree/src/example"]
  }

  readiness {
    http {
      path = "/"
      port = self.vars.port
    }
    period            = "200ms"
    failure_threshold = 50
  }
}
