# examples/worktree — parallel, isolated worktrees over THIS file.
#
# Path resolution:
#   * `src = "../.."` is relative to THIS Alphasfile's dir
#     (examples/worktree) → the zordon repo root. That repo is the
#     primary; each worktree is a `git worktree add` of it.
#   * `exe` is the Go main package, relative to the primary (repo) root.
#   * `worktree.sparse` paths are relative to the primary (repo) root
#     (what `git sparse-checkout set` expects) — so the checkout holds
#     ONLY examples/worktree/src/example, nothing else from the repo.

service "go" "example" {
  src = "../.."
  exe = "./examples/worktree/src/example"

  vars = {
    port = net::pickport()
  }

  cmd = [
    "${fs::bin()}/example",
    "-addr", "127.0.0.1:${self.vars.port}",
    "-tag", "${pathhash()}",
  ]

  worktree {
    sparse = ["examples/worktree/src/example"]
  }

  readiness {
    http {
      path = "/"
      port = self.vars.port
    }
    period            = "200ms"
    failure_threshold = 50
  }
}
