service "go" "serviceA" {
  src = "../.."
  exe = "./examples/worktree/src/serviceA"

  vars = {
    port = net::pickport()
  }

  runtime {
    cmd = [
      "${fs::bin()}/serviceA",
      "-addr", "127.0.0.1:${self.vars.port}",
      "-tag", "${fs::hash()}",
    ]
  }

  print = "http://127.0.0.1:${self.vars.port}/  (serviceA, worktree ${fs::hash()})"

  worktree {
    sparse = ["examples/worktree/src/serviceA"]
  }

  readiness {
    http {
      path = "/"
      port = self.vars.port
    }
    period            = "200ms"
    failure_threshold = 50
  }
}

