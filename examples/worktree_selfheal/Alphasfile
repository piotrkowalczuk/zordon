sysenv = ["HOME", "USER", "PATH", "LANG", "LC_ALL", "TZ", "TERM", "TMPDIR"]

service "go" "app" {
  src {
    path = "../.."
    exe  = "./examples/worktree_selfheal/src/app"
  }

  vars = {
    port = net::pickport()
  }

  runtime {
    cmd = [
      "${fs::bin()}/app",
      "-addr", "127.0.0.1:${self.vars.port}",
      "-tag", "${fs::hash()}",
    ]
  }

  print = "http://127.0.0.1:${self.vars.port}/  (app, workspace ${fs::hash()})"

  workspace {
    sparse = ["examples/worktree_selfheal/src/app"]
  }

  readiness {
    http {
      path = "/"
      port = self.vars.port
    }
    period            = "200ms"
    failure_threshold = 50
  }
}
