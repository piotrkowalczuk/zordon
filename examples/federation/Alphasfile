# Federation root: shared infrastructure every project below can lean on.
#
# Caddy runs as a reverse proxy that hot-reloads from a config directory:
# any service lower in the chain just drops its own `<name>.caddy` fragment
# into service.go.caddy.vars.config_dir and Caddy (`--watch`) picks it up.
# No admin API, no per-app glue code.
#
# CoreDNS resolves *.zordon.com -> 127.0.0.1 so the vhosts are reachable
# by name.

service "go" "caddy" {
  import = "github.com/caddyserver/caddy/v2/cmd/caddy"

  vars = {
    http       = net::pickport()
    config_dir = "${tmpdir()}/conf.d"
  }

  # Main Caddyfile: a health endpoint for readiness + a glob import of the
  # drop-in directory children write into.
  file "caddyfile" {
    path = "${tmpdir()}/Caddyfile"
    body = <<-EOT
      {
      	admin off
      	auto_https off
      }

      :${self.vars.http} {
      	respond /healthz "ok" 200
      }

      import ${self.vars.config_dir}/*.caddy
    EOT
  }

  # Seed fragment: makes config_dir exist before Caddy starts (and is a
  # harmless comment as far as Caddy is concerned).
  file "seed" {
    path = "${self.vars.config_dir}/00-root.caddy"
    body = "# zordon federation root — children drop their vhosts here\n"
  }

  command = ["caddy", "run", "--config", self.file.caddyfile.path, "--adapter", "caddyfile", "--watch"]

  readiness {
    http {
      path = "/healthz"
      port = self.vars.http
    }
    period            = "200ms"
    timeout           = "1s"
    failure_threshold = 50
  }

  # Front Caddy on :80 without running it as root: Caddy stays on its
  # unprivileged pickport; pf redirects loopback :80 -> that port. Idempotent
  # via a per-port marker + a one-time /etc/pf.conf anchor hook (both checked
  # WITHOUT sudo, so steady state never prompts). A backup is kept at
  # /etc/pf.conf.zordon.bak.
  #
  # Revert:
  #   sudo pfctl -a zordon -F all
  #   sudo sed -i '' '/rdr-anchor "zordon"/d' /etc/pf.conf
  #   sudo pfctl -f /etc/pf.conf
  sudo "http80" {
    check  = "test -f '${tmpdir()}/pf80.${self.vars.http}' && grep -q 'rdr-anchor \"zordon\"' /etc/pf.conf"
    apply  = <<-EOT
      set -e
      cp -n /etc/pf.conf /etc/pf.conf.zordon.bak 2>/dev/null || true
      if ! grep -q 'rdr-anchor "zordon"' /etc/pf.conf; then
        awk '{print} /^rdr-anchor "com\.apple\/\*"/{print "rdr-anchor \"zordon\""}' /etc/pf.conf > /etc/pf.conf.zordon.new
        grep -q 'rdr-anchor "zordon"' /etc/pf.conf.zordon.new || { echo 'could not locate apple rdr-anchor in /etc/pf.conf; aborting' >&2; rm -f /etc/pf.conf.zordon.new; exit 1; }
        cat /etc/pf.conf.zordon.new > /etc/pf.conf
        rm -f /etc/pf.conf.zordon.new
      fi
      pfctl -f /etc/pf.conf
      echo 'rdr pass on lo0 inet proto tcp from any to 127.0.0.1 port 80 -> 127.0.0.1 port ${self.vars.http}' | pfctl -a zordon -f -
      pfctl -e 2>/dev/null || true
      mkdir -p '${tmpdir()}'
      : > '${tmpdir()}/pf80.${self.vars.http}'
    EOT
    verify = "nc -z -G 2 127.0.0.1 80"
  }
}

service "go" "coredns" {
  import = "github.com/coredns/coredns"

  vars = {
    dns = net::pickport()
  }

  # Serve the whole `.test` TLD (RFC 6761 — reserved, never public, and
  # NOT mDNS like `.local`). Children pick collision-free hostnames under
  # it via pathhash(): "<svc>.<hash>.test".
  file "corefile" {
    path = "${tmpdir()}/Corefile"
    body = <<-EOT
      test:${self.vars.dns} {
        template IN A {
          answer "{{ .Name }} 60 IN A 127.0.0.1"
        }
        log
      }
    EOT
  }

  command = ["coredns", "-conf", self.file.corefile.path]

  # Point macOS's resolver for *.test at this CoreDNS instance so the
  # browser (not just `dig @127.0.0.1 -p`) resolves the vhosts. Idempotent:
  # `check` (no sudo) passes when the file already has the current port, so
  # steady-state restarts don't prompt for a password. Only a changed DNS
  # port triggers `apply` (one prompt), then `verify` confirms it.
  sudo "resolver" {
    check  = "grep -qxF 'port ${self.vars.dns}' /etc/resolver/test 2>/dev/null"
    apply  = <<-EOT
      mkdir -p /etc/resolver && printf 'nameserver 127.0.0.1\nport ${self.vars.dns}\n' > /etc/resolver/test
    EOT
    verify = "grep -qxF 'port ${self.vars.dns}' /etc/resolver/test"
  }
}
