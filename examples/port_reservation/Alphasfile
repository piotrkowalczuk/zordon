sysenv = ["HOME", "USER", "PATH", "LANG", "LC_ALL", "TZ", "TERM", "TMPDIR"]

# Demonstrates 3-layer port reservation for `net::pickport()`:
#   1. Non-ephemeral pool (20000..31999) + cross-process flock under
#      `<ZORDON_HOME>/locks/port-<port>.lock`.
#   2. `alpha` holds a LISTEN socket on each service's picked port throughout
#      toolchain install, workspace preparation, build, and `runtime.after`.
#   3. Right before `cmd.Start()`, `alpha` transitions the reservation socket
#      into `TIME_WAIT` (`SO_REUSEADDR=1`) so the service binds immediately
#      while concurrent `bind(:0)` / `net::pickport()` probes cannot steal it.

service "go" "app" {
  src {
    path = "../.."
    exe  = "./examples/port_reservation/src/app"
  }

  vars = { port = net::pickport() }

  build {
    cmd = [
      "/bin/sh",
      "-c",
      "go run . -probe-port ${self.vars.port} > \"${fs::state()}/build-port.env\"; go build -o \"${fs::bin()}/app\" .",
    ]
  }

  runtime {
    cmd = ["${fs::bin()}/app", "-addr", "127.0.0.1:${self.vars.port}"]
  }

  readiness {
    http {
      path = "/"
      port = self.vars.port
    }
    period            = "200ms"
    failure_threshold = 50
  }
}
