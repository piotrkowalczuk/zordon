sysenv = ["HOME", "USER", "PATH", "LANG", "LC_ALL", "TZ", "TERM", "TMPDIR"]

service "go" "app" {
  src = "../.."
  exe = "./examples/env/src/app"

  vars = { port = net::pickport() }

  file "denv" {
    path = "${fs::tmp()}/app.env"
    body = <<-EOT
      DOTENV_FROM_FILE=1
      OVERRIDE_ME=from-dotenv
      DOTENV_ORDER=first
    EOT
  }

  file "denv2" {
    path = "${fs::tmp()}/app.local.env"
    body = <<-EOT
      DOTENV2_FROM_FILE=1
      DOTENV_ORDER=second
    EOT
  }

  # dotenv accepts a list: files load in order, later wins over earlier
  # (and env{} still wins over all of them).
  dotenv = [self.file.denv.path, self.file.denv2.path]

  env = {
    ENV_STATIC  = "hello"
    ENV_DYN     = "127.0.0.1:${self.vars.port}"
    OVERRIDE_ME = "from-env"
  }

  runtime {
    cmd = ["${fs::bin()}/app", "-addr", "127.0.0.1:${self.vars.port}"]
  }

  readiness {
    http {
      path = "/"
      port = self.vars.port
    }
    period            = "200ms"
    failure_threshold = 50
  }
}
