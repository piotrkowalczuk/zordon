# A blog: a static site served by `hugo server`, generated from file blocks.
# It registers itself with Caddy as blog.<domain>.
package "blog" {
  inputs = {
    domain = "test"
    title  = "zordon blog"
  }

  import "../caddy" {
    provide "sites" {
      host     = "blog.${inputs.domain}"
      upstream = "127.0.0.1:${module.blog.service.go.hugo.vars.port}"
    }
  }

  module "blog" {
    service "go" "hugo" {
      git {
        url = "github.com/gohugoio/hugo"
        tag = "v0.166.0"
      }

      build {
        cmd = ["go", "build", "-o", "${fs::bin()}/hugo", "."]
      }

      vars = {
        port = net::pickport()
      }

      print = "http://127.0.0.1:${self.vars.port}/  (blog, direct)"

      file "config" {
        path = "${fs::etc()}/site/hugo.toml"
        body = <<-EOT
          baseURL = "http://127.0.0.1:${self.vars.port}/"
          title = "${inputs.title}"
          disableKinds = ["taxonomy", "term", "RSS", "sitemap"]
        EOT
      }

      file "index" {
        path = "${fs::etc()}/site/content/_index.md"
        body = "---\ntitle: home\n---\n"
      }

      file "layout" {
        path = "${fs::etc()}/site/layouts/index.html"
        body = "<h1>{{ .Site.Title }}</h1><p>zordon-blog-ok</p>\n"
      }

      runtime {
        cmd = ["${fs::bin()}/hugo", "server", "--source", "${fs::etc()}/site", "--bind", "127.0.0.1", "--port", "${self.vars.port}", "--disableLiveReload", "--renderToMemory"]
      }

      readiness {
        http {
          path = "/"
          port = self.vars.port
        }
        period            = "200ms"
        failure_threshold = 100
      }
    }
  }
}
