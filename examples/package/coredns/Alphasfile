# A DNS server that answers every name in one zone with 127.0.0.1. With
# feature resolver it also tells macOS to send lookups for the zone here, so
# a browser reaches <anything>.<zone>.
package "coredns" {
  inputs = {
    zone = {
      description = "The zone to answer; every name in it resolves to 127.0.0.1."
      type        = string
      default     = "test"
    }
    dns_port = {
      description = "Port to answer on. Fixed rather than picked: /etc/resolver/<zone> names it and must stay valid across restarts."
      type        = number
      default     = 49564
    }
  }
  features = {
    resolver = { description = "Writes /etc/resolver/<zone> with sudo (macOS), so a browser resolves *.<zone> through CoreDNS." }
  }
  outputs = {
    zone = {
      description = "The zone CoreDNS answers."
      type        = string
      value       = module.coredns.service.go.coredns.vars.zone
    }
    dns = {
      description = "Where CoreDNS answers, as host:port."
      type        = string
      value       = "127.0.0.1:${module.coredns.service.go.coredns.vars.dns}"
    }
  }

  module "coredns" {
    service "go" "coredns" {
      git {
        url = "github.com/coredns/coredns"
        tag = "v1.14.7"
      }

      build {
        cmd = ["go", "build", "-o", "${fs::bin()}/coredns", "."]
      }

      vars = {
        zone   = inputs.zone
        dns    = inputs.dns_port
        health = net::pickport()
      }

      file "corefile" {
        path = "${fs::etc()}/Corefile"
        body = <<-EOT
          ${self.vars.zone}:${self.vars.dns} {
            template IN A {
              answer "{{ .Name }} 60 IN A 127.0.0.1"
            }
            health 127.0.0.1:${self.vars.health}
            log
          }
        EOT
      }

      runtime {
        cmd = ["${fs::bin()}/coredns", "-conf", self.file.corefile.path]
      }

      readiness {
        http {
          path = "/health"
          port = self.vars.health
        }
        period            = "200ms"
        failure_threshold = 50
      }

      # macOS only: /etc/resolver/<zone> routes the zone's lookups here.
      sudo "resolver" {
        enabled = features.resolver
        check   = "grep -qxF 'port ${self.vars.dns}' /etc/resolver/${self.vars.zone} 2>/dev/null"
        apply   = <<-EOT
          mkdir -p /etc/resolver && printf 'nameserver 127.0.0.1\nport ${self.vars.dns}\n' > /etc/resolver/${self.vars.zone}
        EOT
        verify  = "grep -qxF 'port ${self.vars.dns}' /etc/resolver/${self.vars.zone}"
      }
    }
  }
}
