{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-gofmt.sh\"",
            "timeout": 180,
            "statusMessage": "post-edit gate: make fmt…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-git-quality-gate.sh\"",
            "if": "Bash(git *)",
            "timeout": 900,
            "statusMessage": "pre-git gate: make lint + test…"
          }
        ]
      }
    ]
  }
}
